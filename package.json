{
  "name": "effect-uai-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Low-level primitives for AI agents in Effect.",
  "keywords": [
    "agents",
    "ai",
    "effect",
    "llm",
    "openai",
    "streaming",
    "typescript"
  ],
  "homepage": "https://effect-uai.betalyra.com",
  "bugs": {
    "url": "https://github.com/betalyra/effect-uai/issues"
  },
  "license": "MIT",
  "author": "Betalyra",
  "repository": {
    "type": "git",
    "url": "https://github.com/betalyra/effect-uai"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "integration-tests/sandbox-microsandbox/node_modules/.bin/vitest --root integration-tests/sandbox-microsandbox run",
    "test:integration:microsandbox": "integration-tests/sandbox-microsandbox/node_modules/.bin/vitest --root integration-tests/sandbox-microsandbox run",
    "test:integration:deno": "integration-tests/sandbox-deno/node_modules/.bin/vitest --root integration-tests/sandbox-deno run",
    "test:integration:tokenizer": "pnpm --filter @effect-uai/integration-tokenizer test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:core": "pnpm --filter @effect-uai/core typecheck",
    "typecheck:responses": "pnpm --filter @effect-uai/responses typecheck",
    "typecheck:recipes": "pnpm --filter @effect-uai/recipes typecheck",
    "typecheck:webpage": "pnpm --filter webpage typecheck",
    "lint:effect": "effect-language-service diagnostics --project ./tsconfig.json --format pretty",
    "lint:effect:strict": "effect-language-service diagnostics --project ./tsconfig.json --format text --strict",
    "build": "pnpm --filter \"@effect-uai/*\" -r build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "dev:webpage": "pnpm --filter webpage dev",
    "start:webpage": "pnpm --filter webpage start",
    "build:webpage": "pnpm --filter webpage build",
    "preview:webpage": "pnpm --filter webpage preview",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "oxfmt": "^0.64.0",
    "tsdown": "^0.22.14",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.22.0"
}
