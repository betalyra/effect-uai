{
  "name": "@effect-uai/ai-sdk",
  "version": "0.13.0",
  "description": "Vercel AI SDK (useChat) UI Message Stream compatibility for @effect-uai/core.",
  "keywords": [
    "agents",
    "ai",
    "ai-sdk",
    "effect",
    "streaming",
    "usechat",
    "vercel"
  ],
  "homepage": "https://github.com/betalyra/effect-uai/tree/main/packages/compat/ai-sdk",
  "bugs": {
    "url": "https://github.com/betalyra/effect-uai/issues"
  },
  "license": "MIT",
  "author": "Betalyra",
  "repository": {
    "type": "git",
    "url": "https://github.com/betalyra/effect-uai",
    "directory": "packages/compat/ai-sdk"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./UIMessageStream": {
      "types": "./dist/UIMessageStream.d.mts",
      "import": "./dist/UIMessageStream.mjs"
    },
    "./Messages": {
      "types": "./dist/Messages.d.mts",
      "import": "./dist/Messages.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@effect-uai/core": "workspace:*",
    "ai": "^7.0.3",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect-uai/core": "workspace:>=0.5.0 <1",
    "effect": "catalog:peer"
  }
}
