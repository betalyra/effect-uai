{
  "name": "@effect-uai/chat-completions",
  "version": "0.12.0",
  "description": "Reusable OpenAI Chat Completions (`/chat/completions`) LanguageModel base for @effect-uai/core. Point it at any compatible gateway (OpenRouter, Groq, Together, self-hosted).",
  "keywords": [
    "ai",
    "chat-completions",
    "effect",
    "gateway",
    "llm",
    "openai",
    "openrouter"
  ],
  "homepage": "https://github.com/betalyra/effect-uai/tree/main/packages/providers/chat-completions",
  "bugs": {
    "url": "https://github.com/betalyra/effect-uai/issues"
  },
  "license": "MIT",
  "author": "Betalyra",
  "repository": {
    "type": "git",
    "url": "https://github.com/betalyra/effect-uai",
    "directory": "packages/providers/chat-completions"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ChatCompletions": {
      "types": "./dist/ChatCompletions.d.mts",
      "import": "./dist/ChatCompletions.mjs"
    },
    "./codec": {
      "types": "./dist/codec.d.mts",
      "import": "./dist/codec.mjs"
    },
    "./http": {
      "types": "./dist/http.d.mts",
      "import": "./dist/http.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect-uai/core": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect-uai/core": "workspace:>=0.2.0 <1",
    "effect": "catalog:peer"
  }
}
