{
  "name": "@effect-uai/discord",
  "version": "0.14.0",
  "description": "Discord provider for @effect-uai/core (Messenger capability over the gateway and REST API).",
  "keywords": [
    "agents",
    "ai",
    "bot",
    "discord",
    "effect",
    "messenger"
  ],
  "homepage": "https://github.com/betalyra/effect-uai/tree/main/packages/providers/discord",
  "bugs": {
    "url": "https://github.com/betalyra/effect-uai/issues"
  },
  "license": "MIT",
  "author": "Betalyra",
  "repository": {
    "type": "git",
    "url": "https://github.com/betalyra/effect-uai",
    "directory": "packages/providers/discord"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./Discord": {
      "types": "./dist/Discord.d.mts",
      "import": "./dist/Discord.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect-uai/core": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect-uai/core": "workspace:>=0.14.0 <1",
    "effect": "catalog:peer"
  }
}
