{
  "name": "@effect-uai/firecrawl",
  "version": "0.12.0",
  "description": "Firecrawl provider for @effect-uai/core (web read).",
  "keywords": [
    "ai",
    "effect",
    "firecrawl",
    "scrape",
    "web-read"
  ],
  "homepage": "https://github.com/betalyra/effect-uai/tree/main/packages/providers/firecrawl",
  "bugs": {
    "url": "https://github.com/betalyra/effect-uai/issues"
  },
  "license": "MIT",
  "author": "Betalyra",
  "repository": {
    "type": "git",
    "url": "https://github.com/betalyra/effect-uai",
    "directory": "packages/providers/firecrawl"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
