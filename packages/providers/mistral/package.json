{
  "name": "@effect-uai/mistral",
  "version": "0.12.0",
  "description": "Mistral provider for @effect-uai/core: chat-completions plus Voxtral speech-to-text and text-to-speech.",
  "keywords": [
    "ai",
    "effect",
    "llm",
    "mistral",
    "speech",
    "stt",
    "transcription",
    "tts",
    "voxtral"
  ],
  "homepage": "https://github.com/betalyra/effect-uai/tree/main/packages/providers/mistral",
  "bugs": {
    "url": "https://github.com/betalyra/effect-uai/issues"
  },
  "license": "MIT",
  "author": "Betalyra",
  "repository": {
    "type": "git",
    "url": "https://github.com/betalyra/effect-uai",
    "directory": "packages/providers/mistral"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./Mistral": {
      "types": "./dist/Mistral.d.mts",
      "import": "./dist/Mistral.mjs"
    },
    "./MistralTranscriber": {
      "types": "./dist/MistralTranscriber.d.mts",
      "import": "./dist/MistralTranscriber.mjs"
    },
    "./MistralRealtimeTranscriber": {
      "types": "./dist/MistralRealtimeTranscriber.d.mts",
      "import": "./dist/MistralRealtimeTranscriber.mjs"
    },
    "./MistralSynthesizer": {
      "types": "./dist/MistralSynthesizer.d.mts",
      "import": "./dist/MistralSynthesizer.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect-uai/chat-completions": "workspace:*"
  },
  "devDependencies": {
    "@effect-uai/core": "workspace:*",
    "@types/ws": "^8.5.13",
    "effect": "4.0.0-beta.94",
    "typescript": "^6.0.3",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@effect-uai/core": "workspace:>=0.2.0 <1",
    "effect": ">=4.0.0-beta.94 <5.0.0",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  }
}
