{
  "name": "@effect-uai/perplexity",
  "version": "0.12.0",
  "description": "Perplexity provider for @effect-uai/core (web search).",
  "keywords": [
    "ai",
    "effect",
    "perplexity",
    "search",
    "web-search"
  ],
  "homepage": "https://github.com/betalyra/effect-uai/tree/main/packages/providers/perplexity",
  "bugs": {
    "url": "https://github.com/betalyra/effect-uai/issues"
  },
  "license": "MIT",
  "author": "Betalyra",
  "repository": {
    "type": "git",
    "url": "https://github.com/betalyra/effect-uai",
    "directory": "packages/providers/perplexity"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./PerplexityDeepResearch": {
      "types": "./dist/PerplexityDeepResearch.d.mts",
      "import": "./dist/PerplexityDeepResearch.mjs"
    },
    "./PerplexitySearch": {
      "types": "./dist/PerplexitySearch.d.mts",
      "import": "./dist/PerplexitySearch.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect-uai/core": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect-uai/core": "workspace:>=0.2.0 <1",
    "effect": "catalog:peer"
  }
