{
  "name": "@effect-uai/typesafe-ai",
  "version": "0.17.0",
  "description": "TypeSafe AI provider for @effect-uai/core (Jev System One decision model).",
  "keywords": [
    "ai",
    "classification",
    "decision-model",
    "effect",
    "jev",
    "typesafe"
  ],
  "homepage": "https://github.com/betalyra/effect-uai/tree/main/packages/providers/typesafe-ai",
  "bugs": {
    "url": "https://github.com/betalyra/effect-uai/issues"
  },
  "license": "MIT",
  "author": "Betalyra",
  "repository": {
    "type": "git",
    "url": "https://github.com/betalyra/effect-uai",
    "directory": "packages/providers/typesafe-ai"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./Jev": {
      "types": "./dist/Jev.d.mts",
      "import": "./dist/Jev.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect-uai/core": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect-uai/core": "workspace:>=0.17.0 <1",
    "effect": "catalog:peer"
  }
}
