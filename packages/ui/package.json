{
  "name": "@effect-uai/ui",
  "version": "0.19.0",
  "description": "Agentic UI primitives for @effect-uai/core: a resumable run-event protocol, projection, client folds and Effect atoms.",
  "keywords": [
    "agents",
    "ai",
    "chat",
    "effect",
    "sse",
    "streaming",
    "ui"
  ],
  "homepage": "https://github.com/betalyra/effect-uai/tree/main/packages/ui",
  "bugs": {
    "url": "https://github.com/betalyra/effect-uai/issues"
  },
  "license": "MIT",
  "author": "Betalyra",
  "repository": {
    "type": "git",
    "url": "https://github.com/betalyra/effect-uai",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./RunEvent": {
      "types": "./dist/RunEvent.d.mts",
      "import": "./dist/RunEvent.mjs"
    },
    "./Input": {
      "types": "./dist/Input.d.mts",
      "import": "./dist/Input.mjs"
    },
    "./Projection": {
      "types": "./dist/Projection.d.mts",
      "import": "./dist/Projection.mjs"
    },
    "./Run": {
      "types": "./dist/Run.d.mts",
      "import": "./dist/Run.mjs"
    },
    "./RunView": {
      "types": "./dist/RunView.d.mts",
      "import": "./dist/RunView.mjs"
    },
    "./Thread": {
      "types": "./dist/Thread.d.mts",
      "import": "./dist/Thread.mjs"
    },
    "./UiContract": {
      "types": "./dist/UiContract.d.mts",
      "import": "./dist/UiContract.mjs"
    },
    "./SseEncoding": {
      "types": "./dist/SseEncoding.d.mts",
      "import": "./dist/SseEncoding.mjs"
    },
    "./Client": {
      "types": "./dist/Client.d.mts",
      "import": "./dist/Client.mjs"
    },
    "./Transport": {
      "types": "./dist/Transport.d.mts",
      "import": "./dist/Transport.mjs"
    },
    "./Atoms": {
      "types": "./dist/Atoms.d.mts",
      "import": "./dist/Atoms.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@effect-uai/core": "workspace:*",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect-uai/core": "workspace:>=0.17.0 <1",
    "effect": "catalog:peer"
  }
}
